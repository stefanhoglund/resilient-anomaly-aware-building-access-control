# Copy to .env for local development. Consumed by the services via the
# process environment.

# --- BuildSim (cmd/buildsim-probe, cmd/door-actuator) ---

# BuildSim origin. Required. No default — a missing value is a fatal
# startup error so a misconfigured deployment fails fast.
BUILDSIM_URL=http://127.0.0.1:9090

# Per-call timeout as a Go duration. Optional, default 5s.
BUILDSIM_TIMEOUT=5s

# --- Event bus client (all services) ---

# Bus origin. Optional, default http://127.0.0.1:8080.
EVENTBUS_URL=http://127.0.0.1:8080
# Publish call timeout. Optional, default 5s.
EVENTBUS_TIMEOUT=5s
# Subscription idle timeout before reconnect. Optional, default 45s.
EVENTBUS_IDLE_TIMEOUT=45s

# --- Event bus server (cmd/eventbus) ---

# Listen address. Optional, default ":8080".
EVENTBUS_ADDR=:8080
# Per-subscriber queue depth / retained history / keep-alive interval.
EVENTBUS_BUFFER=256
EVENTBUS_HISTORY=1024
EVENTBUS_HEARTBEAT=15s

# --- Fault injection (cmd/eventbus) — OFF unless set ---
# Used only by the resilience tests. Logged loudly when enabled.
FAULT_DROP_RATE=0        # [0,1] probability a delivery is dropped
FAULT_DUPLICATE=0        # [0,1] probability a delivery is duplicated
FAULT_DELAY_MS=0         # milliseconds added before each delivery
FAULT_REORDER=false      # occasionally swap adjacent events
FAULT_SEED=0             # fixed RNG seed for reproducible fault runs (0 = time)
